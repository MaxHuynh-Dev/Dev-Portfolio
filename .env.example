NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=https://api.example.com

# Payload CMS
# MongoDB connection string (local, Docker, or MongoDB Atlas)
DATABASE_URI=mongodb://127.0.0.1:27017/nextjs-template
# The database inside that cluster. Atlas connection strings often end at
# the host with no path, which would otherwise default to `test`.
DATABASE_NAME=dev-portfolio
# Used to encrypt/sign data — generate with: openssl rand -hex 32
PAYLOAD_SECRET=your-secret-key-here

# Cloudinary — where uploaded imagery lives.
# Copy this whole string from the Cloudinary dashboard; the SDK reads it
# by itself and derives the cloud name, key and secret from it.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=dev-portfolio
