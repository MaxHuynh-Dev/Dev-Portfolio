{
  "name": "dev-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "payload run src/payload/seed.ts",
    "seed:reset": "SEED_RESET=1 payload run src/payload/seed.ts",
    "seed:experience": "payload run src/payload/seedExperience.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.90.0",
    "@payloadcms/next": "3.90.0",
    "@payloadcms/plugin-cloud-storage": "3.90.0",
    "cloudinary": "2.11.0",
    "clsx": "^2.1.1",
    "graphql": "^16.14.1",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "lottie-web": "^5.13.0",
    "next": "^16.3.5",
    "payload": "3.90.0",
    "postcss": "^8.5.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "5.7.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.19",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,scss,md,json}": [
      "biome check --write --no-errors-on-unmatched",
      "biome check --write --organize-imports-enabled=false --no-errors-on-unmatched",
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
